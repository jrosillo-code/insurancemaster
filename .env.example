# ─── Rosillo AI Platform — SYNTHETIC DATA ONLY ───────────────────────────────
# This prototype must never be pointed at real Rosillo or customer data, at
# segElevia, at the Rosillo customer app, at insurer portals, or at a mailbox.

# Session signing key. Generate with: openssl rand -hex 32
# Development falls back to this placeholder and warns. Production REFUSES to issue or
# verify a session unless this is set, differs from the placeholder, and is >= 32 chars.
AUTH_SECRET=dev-only-secret-change-me

# AI provider. "mock" (default) is fully deterministic and needs no network.
# "anthropic" is opt-in for evaluation only and requires ANTHROPIC_API_KEY.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# Optional override. Unset uses the code default (claude-opus-5).
# ANTHROPIC_MODEL=

# Persistence. Unset DATABASE_URL uses local JSONL files; setting it selects Postgres,
# which is required for any hosted deployment (a serverless filesystem is neither
# shared between the two apps nor durable). See docs/deployment.md.
ROSILLO_DATA_DIR=.data
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Force a specific store: memory | jsonl | postgres
# ROSILLO_STORE=

# Development-only: log raw synthetic message content. Never enable outside local dev.
LOG_RAW_CONTENT=false
