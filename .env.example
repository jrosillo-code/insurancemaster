# ─── Rosillo AI Platform — SYNTHETIC DATA ONLY ───────────────────────────────
# This prototype must never be pointed at real Rosillo or customer data, at
# segElevia, at the Rosillo customer app, at insurer portals, or at a mailbox.

# Session cookie signing key. Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-secret-change-me

# AI provider. "mock" (default) is fully deterministic and needs no network.
# "anthropic" is opt-in for evaluation only and requires ANTHROPIC_API_KEY.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# Optional override. Unset uses the code default (claude-opus-5).
# ANTHROPIC_MODEL=

# Where the append-only JSONL store writes conversations, tasks and audit events.
ROSILLO_DATA_DIR=.data

# Development-only: log raw synthetic message content. Never enable outside local dev.
LOG_RAW_CONTENT=false
